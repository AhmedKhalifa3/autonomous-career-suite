# ==============================================================================
# Autonomous Career Suite: Central Configuration
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Notion API Credentials (Used by notion-tracker-mcp, job-discovery-inbox, & career-dashboard-gui)
# ------------------------------------------------------------------------------
NOTION_API_KEY=ntn_your_notion_api_secret_key_here

# Database 1: Main Job Applications Tracker (Status: Applied, Screening, Interview, Offer)
NOTION_DATABASE_ID=your_applications_database_id_here

# Database 2: Job Discovery Inbox (Status: New, Approved, Dismissed, Applied)
NOTION_DISCOVERED_JOBS_DB_ID=your_discovery_inbox_database_id_here

# ------------------------------------------------------------------------------
# 2. Overleaf CLSI Cloud Compiler Credentials (Used by overleaf-cv-agent)
# ------------------------------------------------------------------------------
OVERLEAF_PROJECT_ID=your_overleaf_project_id_here
OVERLEAF_SESSION_COOKIE=your_overleaf_session_cookie_here
